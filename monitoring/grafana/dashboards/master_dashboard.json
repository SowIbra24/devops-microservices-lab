{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "#EAB839", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 0 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showThresholdMarkers": true
      },
      "targets": [
        { "expr": "rate(flask_app_hits_total[1m])", "refId": "A" }
      ],
      "title": "Metrics Prometheus (Rate)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 0 },
      "id": 1,
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        { "expr": "{container=~\".+\"} | json", "refId": "A" }
      ],
      "title": "Logs Docker (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "time": { "from": "now-5m", "to": "now" },
  "title": "Master Dashboard CI",
  "uid": "master-ci-dashboard"
}